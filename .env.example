# ─── Core ──────────────────────────────────────────────────────────────
# Public URL of the site (used in links inside WhatsApp messages, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Long random string (32+ chars). Signs the verified-phone cookie and hashes OTP codes.
# REQUIRED whenever NODE_ENV=production (the server will not start without it).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=
# true = show the "Demo" banner and allow the on-screen mock OTP. Set to false when you go live.
DEMO_MODE=true

# ─── Database ──────────────────────────────────────────────────────────
# Postgres connection string (Supabase: Project Settings → Database → Connection string, "Transaction" pooler).
# Leave empty to use the embedded PGlite database (local demo only; not for Vercel).
DATABASE_URL=
DATABASE_POOL_SIZE=5
# Where the embedded PGlite database lives when DATABASE_URL is empty.
PGLITE_DIR=./node_modules/.cache/bba-pglite

# ─── Payments ──────────────────────────────────────────────────────────
# mock | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── WhatsApp messaging ────────────────────────────────────────────────
# mock | meta | bsp
MESSAGING_PROVIDER=mock
# en | te  (template language)
MESSAGE_LANGUAGE=en
# Retry backoff base for failed sends (ms): 1s, 2s, 4s…
MESSAGE_RETRY_BASE_MS=1000
# Meta WhatsApp Cloud API
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_API_VERSION=v21.0
# Generic BSP (Interakt / AiSensy / Gupshup style)
BSP_API_URL=
BSP_API_KEY=
BSP_AUTH_HEADER=Authorization
BSP_AUTH_PREFIX=Basic

# ─── OTP ───────────────────────────────────────────────────────────────
# mock | whatsapp | sms
OTP_PROVIDER=mock
# Cloudflare Turnstile "I'm human" check on "send code". Optional in demo, REQUIRED on a live site
# (the server refuses to start without both keys). Tokens must be for action "otp_send" and one of the
# hostnames below (comma-separated; defaults to the host of NEXT_PUBLIC_SITE_URL).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=
# MSG91 (when OTP_PROVIDER=sms)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# ─── Gallery storage ───────────────────────────────────────────────────
# db | supabase
STORAGE_PROVIDER=db
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=gallery

# ─── Cron ──────────────────────────────────────────────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Required in production (16+ chars).
CRON_SECRET=

# ─── Security ──────────────────────────────────────────────────────────
# Admin two-factor login (code sent to the admin's phone). Default: on for a live site, off in demo.
# Set false only if you accept password-only dashboard logins (the server prints a warning).
ADMIN_2FA_REQUIRED=
# Shared rate-limit / cache store. Empty = Postgres tables (works on any number of servers).
# Set both to use Upstash Redis instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# bcrypt work factor for admin passwords (default 12).
BCRYPT_COST=12

# ─── Monitoring ───────────────────────────────────────────────────────
# Optional Sentry DSN. Unexpected server errors are sent with phones/e-mails masked and no request
# bodies, headers or cookies. A live server warns at startup when it's empty.
SENTRY_DSN=

# ─── Tests only ────────────────────────────────────────────────────────
# Real Postgres for `npm run test:concurrency` / `npm run test:realdb`. Empty = a throwaway embedded Postgres 17.
# Each test run creates and drops its own schema. Hosts other than localhost/127.0.0.1/::1/postgres are refused
# unless listed in TEST_DB_ALLOWED_HOSTS (e.g. a Supabase *staging* project) — never point this at production.
TEST_DATABASE_URL=
TEST_DB_ALLOWED_HOSTS=
